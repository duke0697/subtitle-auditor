{
  "name": "subtitle-auditor",
  "version": "0.1.3",
  "description": "Windows desktop subtitle auditing tool (ASR confidence + diff)",
  "main": "./out/main/index.js",
  "author": "Boss",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "prebuild": "node scripts/make-icon.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "setup:sidecar": "node scripts/setup-sidecar.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "make:icon": "node scripts/make-icon.mjs",
    "test:sidecar": "sidecar/.venv/Scripts/python.exe -m pytest tests/sidecar -q",
    "dist": "npm run build:sidecar && npm run fetch:ffmpeg && npm run build && electron-builder --win nsis",
    "release": "npm run build:sidecar && npm run fetch:ffmpeg && npm run build && electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.3.0",
    "clsx": "^2.1.1",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^1.72.0",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.34.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "zustand": "^5.1.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0"
  }
}
